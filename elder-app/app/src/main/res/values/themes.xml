<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FindMa" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg</item>
    </style>

    <style name="CardTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="CardBody">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="BigButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
</resources>
