{
  "name": "findma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FindMa 老人防丢系统 · 云端（Cloudflare Workers + Hono + D1）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create findma",
    "db:init:local": "wrangler d1 execute findma --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute findma --remote --file=./schema.sql",
    "db:reset:local": "wrangler d1 execute findma --local --file=./schema.sql --yes",
    "secret:jwt": "wrangler secret put JWT_SECRET",
    "log": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.130.0"
  }
}
